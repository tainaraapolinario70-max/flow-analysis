rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Função auxiliar para validar usuário autenticado
    function isAuthenticated() {
      return request.auth != null;
    }

    // Coleção de Usuários
    match /users/{userId} {
      allow read, write: if isAuthenticated();
    }

    // Registros e Operações do Sistema
    match /daily_records/{docId} { allow read, write: if isAuthenticated(); }
    match /school_updates/{docId} { allow read, write: if isAuthenticated(); }
    match /school_accesses/{docId} { allow read, write: if isAuthenticated(); }
    match /validation_records/{docId} { allow read, write: if isAuthenticated(); }
    match /app_metadata/{docId} { allow read, write: if isAuthenticated(); }
    match /app_settings/{docId} { allow read, write: if isAuthenticated(); }
  }
}
