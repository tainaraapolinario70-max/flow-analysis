rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    match /users/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create: if isAdmin() || (signedIn() && request.auth.uid == uid && request.resource.data.role == 'technician');
      allow update: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow delete: if isAdmin();
    }
    match /assignments/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.technicianUid == request.auth.uid);
      allow create: if isAdmin();
      allow update: if isAdmin() || (signedIn() && resource.data.technicianUid == request.auth.uid);
      allow delete: if isAdmin();
    }
    match /checklists/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.technicianUid == request.auth.uid);
      allow create: if isAdmin() || (signedIn() && request.resource.data.technicianUid == request.auth.uid);
      allow update: if isAdmin() || (signedIn() && resource.data.technicianUid == request.auth.uid && request.resource.data.technicianUid == request.auth.uid);
      allow delete: if isAdmin();
    }
  }
}
